[Unit]
Description=SPOT Core read-only seven-day stability observer
After=docker.service spot-mcp.service spot-bridge-api.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/home/ogre/spot-stack/watch/stability/spot-core-stability-observer.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/spot/stability-soak
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
