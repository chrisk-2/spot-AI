[Unit]
Description=Enforce Spot failover shared service endpoint
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/spot-failover/endpoint.env

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/spot-failover-endpoint enforce
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/lock
